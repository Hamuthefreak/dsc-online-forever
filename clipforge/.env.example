# ---- core paths -------------------------------------------------------------
CLIPFORGE_OUT=./runs

# ---- disk -------------------------------------------------------------------
# smallest footprint: tiny ASR + 720p source + CRF 23
CLIPFORGE_LOW_DISK=0
# refuse to start a run with less than this much free space
CLIPFORGE_MIN_FREE_MB=300
# cap the audio-only fallback download (0 = whole stream)
CLIPFORGE_SIGNAL_MAX_MINUTES=0
# point the Whisper model cache at another drive if the main disk is small
# HF_HOME=D:/clipforge/models

# ---- selection --------------------------------------------------------------
CLIPFORGE_MIN_CLIPS=4
CLIPFORGE_MAX_CLIPS=10
CLIPFORGE_CLIP_MIN_S=15
CLIPFORGE_CLIP_MAX_S=45
CLIPFORGE_PRE_ROLL=6
CLIPFORGE_POST_ROLL=18
CLIPFORGE_MIN_GAP_S=75
CLIPFORGE_PEAK_Z=2.5

# ---- ingest -----------------------------------------------------------------
CLIPFORGE_MAX_HEIGHT=1080
CLIPFORGE_LIVE_MINUTES=45
# CLIPFORGE_COOKIES=/absolute/path/cookies.txt
# CLIPFORGE_YTDLP_EXTRA=--proxy socks5://127.0.0.1:1080

# ---- transcription ----------------------------------------------------------
CLIPFORGE_ASR_MODEL=small
CLIPFORGE_ASR_DEVICE=auto
CLIPFORGE_ASR_COMPUTE=auto
# CLIPFORGE_ASR_LANGUAGE=en

# ---- captions ---------------------------------------------------------------
CLIPFORGE_CAPTIONS=1
CLIPFORGE_CAPTION_FONT=DejaVu Sans
# CLIPFORGE_CAPTION_FONT_FILE=/System/Library/Fonts/Supplemental/Arial Bold.ttf
CLIPFORGE_CAPTION_FONT_SIZE=76
CLIPFORGE_CAPTION_MARGIN_V=300
CLIPFORGE_CAPTION_UPPER=1
CLIPFORGE_CAPTION_WORDS=3

# ---- video / audio ----------------------------------------------------------
CLIPFORGE_REFRAME=fit
CLIPFORGE_ENCODER=auto
CLIPFORGE_CRF=19
CLIPFORGE_LOUDNESS=-14
CLIPFORGE_TRUE_PEAK=-1.5
# CLIPFORGE_MUSIC=/absolute/path/bed.mp3
CLIPFORGE_MUSIC_GAIN=0.16

# ---- metadata (optional; falls back to a heuristic) -------------------------
# OPENAI_API_KEY=...
# OPENAI_BASE_URL=https://api.openai.com/v1
# CLIPFORGE_LLM_MODEL=gpt-4o-mini

# ---- posting ----------------------------------------------------------------
CLIPFORGE_POSTER=none
# UPLOADPOST_API_KEY=...
# UPLOADPOST_USER=your-profile-name
# UPLOADPOST_URL=https://api.upload-post.com/api/upload
# POSTIZ_API_KEY=...
# POSTIZ_URL=https://api.postiz.com/public/v1
# POSTIZ_INTEGRATIONS={"tiktok":"integration-id","youtube":"integration-id","instagram":"integration-id"}
